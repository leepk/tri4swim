generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteContent {
  id             Int      @id @default(1)
  heroEyebrow    String   @default("PRIVATE SWIM LESSONS")
  heroTitle      String   @default("Private Swim Lessons for Kids and Adults")
  heroText       String   @default("Build confidence, improve technique, and stay safe in the water with personalized, one-on-one coaching.")
  heroImage      String   @default("/images/hero.jpg")
  coachName      String   @default("Tri4Swim Coach")
  coachTitle     String   @default("Private Swim Coach")
  coachBio       String   @default("Personalized instruction focused on water safety, technique, confidence, and steady progress.")
  coachImage     String   @default("/images/coach.jpg")
  email          String   @default("mail@example.com")
  phone          String   @default("")
  location       String   @default("Santa Clara, California")
  bookingTitle   String   @default("Book a Private Swim Lesson")
  bookingText    String   @default("Choose a preferred date and time. The coach will contact you to confirm.")
  benefitsTitle  String   @default("Why Tri4Swim")
  benefit1Title  String   @default("Water Safety")
  benefit1Text   String   @default("Learn essential skills for a safer, more confident swim.")
  benefit2Title  String   @default("Better Technique")
  benefit2Text   String   @default("Improve form and swim more efficiently.")
  benefit3Title  String   @default("All Ages Welcome")
  benefit3Text   String   @default("Kids, adults and all skill levels.")
  lessonsTitle   String   @default("Find the Right Lesson for You")
  coachSectionTitle String @default("Personal Coaching. Calm Progress.")
  ctaTitle       String   @default("Ready to get started?")
  ctaText        String   @default("Send your preferred date and time. The coach will contact you to confirm.")
  updatedAt      DateTime @updatedAt
}

model LessonType {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String
  image       String?
  durationMin Int       @default(60)
  priceCents  Int?
  active      Boolean   @default(true)
  sort        Int       @default(0)
  bookings    Booking[]
  courses     Course[]
}

model Availability {
  id        Int     @id @default(autoincrement())
  weekday   Int
  startTime String
  endTime   String
  slotMin   Int     @default(60)
  active    Boolean @default(true)

  @@index([weekday, active])
}

model BlockedTime {
  id        Int      @id @default(autoincrement())
  start     DateTime
  end       DateTime
  title     String   @default("Unavailable")
  note      String?
  createdAt DateTime @default(now())

  @@index([start, end])
}

model Booking {
  id           Int           @id @default(autoincrement())
  lessonTypeId Int?
  lessonType   LessonType?   @relation(fields: [lessonTypeId], references: [id])
  start        DateTime
  end          DateTime
  parentName   String
  studentName  String?
  email        String
  phone        String?
  location     String?
  notes        String?
  source       BookingSource @default(WEBSITE)
  status       BookingStatus @default(PENDING)
  confirmedAt  DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([start, end])
  @@index([status, start])
}

model Testimonial {
  id        Int     @id @default(autoincrement())
  name      String
  quote     String
  rating    Int     @default(5)
  active    Boolean @default(true)
  sort      Int     @default(0)
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum BookingSource {
  WEBSITE
  ADMIN
}


model Course {
  id           Int              @id @default(autoincrement())
  lessonTypeId Int
  lessonType   LessonType       @relation(fields: [lessonTypeId], references: [id])
  parentName   String
  studentName  String?
  email        String
  phone        String?
  location     String?
  notes        String?
  startDate    DateTime
  endDate      DateTime
  active       Boolean          @default(true)
  schedules    CourseSchedule[]
  appointments CourseAppointment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}
model CourseSchedule {
  id        Int    @id @default(autoincrement())
  courseId  Int
  course    Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
  weekday   Int
  startTime String
  endTime   String
  @@index([courseId,weekday])
}
model CourseAppointment {
  id        Int      @id @default(autoincrement())
  courseId  Int
  course    Course   @relation(fields:[courseId],references:[id],onDelete:Cascade)
  start     DateTime
  end       DateTime
  status    CourseAppointmentStatus @default(SCHEDULED)
  note      String?
  createdAt DateTime @default(now())
  @@index([start,status])
}
enum CourseAppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}
